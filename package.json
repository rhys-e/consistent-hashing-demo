{
  "name": "consistent-hash-ring-demo",
  "version": "0.0.1",
  "description": "A demo of a consistent hash ring",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cyber": "VITE_THEME=cyber vite",
    "dev:holographic": "VITE_THEME=holographic vite",
    "build": "vite build",
    "build:cyber": "VITE_THEME=cyber vite build",
    "build:holographic": "VITE_THEME=holographic vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "prepare": "husky",
    "test": "jest"
  },
  "author": "rhys-e",
  "dependencies": {
    "@xstate/react": "6.1.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@storybook/addon-links": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "babel-jest": "30.4.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.3.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.6",
    "tailwindcss": "3.4.19",
    "vite": "8.2.0",
    "wrangler": "4.129.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "zod-validation-error": "4.0.2"
  }
}
